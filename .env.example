# Upstash Redis REST credentials, used by the /api/visitors function on Vercel.
# Create a database at https://console.upstash.com and copy the REST URL + token
# (the REST pair, not the redis:// connection string).
#
# Both are optional: without them /api/visitors still returns 200 with an
# in-memory fallback count, so nothing on the page breaks.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
